!models/student/*.json
!models/student/*.md
!models/teacher/*.pt
!models/teacher/*.json
!models/teacher/*.md

# frontend
frontend/node_modules/
!frontend/dist/**

# experiment artefacts (registry.csv IS tracked)
experiments/results/*
